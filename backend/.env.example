# ==============================================================================
# Prabhakar Agro Mart - Backend Environment Configuration
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database Settings
# Use 'mysql' in Docker/production, or 'sqlite' for zero-dependency local development
DATABASE_ENGINE=mysql
DATABASE_NAME=prabhakar_agro_db
DATABASE_USER=prabhakar_user
DATABASE_PASSWORD=Prabhakar@Agro2026Secure
DATABASE_HOST=mysql
DATABASE_PORT=3306

# CORS and CSRF Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://localhost:3001

# Razorpay Gateway Test / Live Credentials
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_sample_agro_key
RAZORPAY_KEY_SECRET=sample_agro_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_67890

# JWT Token Lifespans
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@prabhakaragromart.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Prabhakar Agro Mart <no-reply@prabhakaragromart.com>
